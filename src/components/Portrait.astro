---
// Shows Nayem's photo from public/photos when present; otherwise a plain, labelled slot.
import { photo } from '../lib/photos';
interface Props { name?: 'portrait' | 'working'; alt: string; ratio?: string; caption?: string }
const { name = 'portrait', alt, ratio = '4 / 5', caption } = Astro.props;
const src = photo(name);
---
<figure class="portrait">
  <div class="frame" style={`aspect-ratio:${ratio}`} data-photo>
    {src
      ? <img src={src} alt={alt} loading="eager" decoding="async" />
      : <div class="slot" role="img" aria-label="Photo coming soon"><span>Photograph<br />to come</span></div>}
  </div>
  {caption && <figcaption class="label">{caption}</figcaption>}
</figure>

<style>
  .portrait { margin: 0; }
  .frame { position: relative; overflow: hidden; background: var(--paper-2); }
  img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.15) contrast(1.04); }
  .slot { position: absolute; inset: 0; display: grid; place-items: center; text-align: center;
    background: repeating-linear-gradient(-45deg, transparent 0 11px, var(--rule) 11px 12px); }
  .slot span { background: var(--paper-2); padding: 10px 16px; font-family: var(--serif); font-style: italic; font-size: 20px; line-height: 1.2; color: var(--muted); }
  figcaption { display: block; margin-top: 12px; }
</style>
