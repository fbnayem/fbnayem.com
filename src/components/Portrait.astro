---
// Shows Nayem's photo from public/photos when present; otherwise a styled placeholder slot.
import { photo } from '../lib/photos';
interface Props { name?: 'portrait' | 'working'; alt: string; ratio?: string; label?: string }
const { name = 'portrait', alt, ratio = '4 / 5', label = 'Your portrait goes here' } = Astro.props;
const src = photo(name);
---
<figure class="portrait tilt" data-tilt="8" style={`aspect-ratio:${ratio}`}>
  {src
    ? <img src={src} alt={alt} loading="eager" decoding="async" />
    : <div class="slot" role="img" aria-label="Photo coming soon"><span class="mono">FBN</span><span class="hint">{label}</span></div>}
  <span class="glare"></span>
  <span class="ring" aria-hidden="true"></span>
</figure>

<style>
  .portrait { position: relative; margin: 0; border-radius: 28px; overflow: hidden; background: transparent; border: 1px solid var(--line-2); box-shadow: 0 60px 120px -40px rgba(0,0,0,0.9), 0 0 0 1px rgba(255,255,255,0.04) inset; }
  img { width: 100%; height: 100%; object-fit: cover; filter: saturate(1.05) contrast(1.05); transform: scale(1.04); }
  .slot { position: absolute; inset: 0; display: grid; place-items: center; align-content: center; gap: 12px;
    background: radial-gradient(120% 80% at 80% 0%, rgba(91,130,255,0.35), transparent 55%), radial-gradient(90% 70% at 0% 100%, rgba(200,255,61,0.16), transparent 60%), linear-gradient(160deg, rgba(24,33,58,0.55), rgba(10,15,28,0.6)); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); }
  .mono { font-family: var(--display); font-size: clamp(64px, 9vw, 120px); font-weight: 800; letter-spacing: -0.06em; background: linear-gradient(180deg,#fff,rgba(255,255,255,0.35)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hint { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .ring { position: absolute; inset: 0; border-radius: inherit; pointer-events: none; background: linear-gradient(180deg, transparent 55%, rgba(7,9,15,0.55)); }
</style>
