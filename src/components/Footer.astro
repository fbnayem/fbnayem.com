---
import Arrow from './Arrow.astro';
import { profile } from '../data/site';
const year = new Date().getFullYear();
const links = [['About', '/about/'], ['Ventures', '/ventures/'], ['Work', '/work/'], ['Insights', '/insights/'], ['Connect', '/connect/'], ['Privacy', '/privacy/']];
---
<footer class="footer night">
  <div class="wrap">
    <div class="marker"><span class="label">Contact</span><span class="label">Bangladesh / Worldwide</span></div>
    <a href="/connect/" class="big">
      Let's build <em>something</em><span class="red">.</span>
      <span class="arrow" aria-hidden="true"><Arrow diagonal /></span>
    </a>
    <div class="grid">
      <div>
        <p class="f-name">{profile.name}</p>
        <p class="f-line">{profile.role}. {profile.footerLine}</p>
      </div>
      <nav aria-label="Footer"><ul>{links.map(([label, href]) => <li><a href={href} class="ulink">{label}</a></li>)}</ul></nav>
    </div>
    <div class="bottom label"><span>© {year} {profile.name}</span><span>Set in Fraunces and Schibsted Grotesk</span></div>
  </div>
</footer>

<style>
  .footer { padding-block: clamp(72px, 9vw, 120px) 28px; }
  .big { display: block; margin: clamp(40px, 6vw, 80px) 0 0; font-family: var(--serif); font-weight: 330; font-size: clamp(56px, 11.5vw, 200px); line-height: 0.9; letter-spacing: -0.045em; text-decoration: none; font-variation-settings: 'opsz' 144, 'SOFT' 30; }
  .arrow { display: inline-grid; place-items: center; width: 0.62em; height: 0.62em; margin-left: 0.12em; vertical-align: 0.04em; border: 1px solid currentColor; border-radius: 50%; transition: background 0.4s var(--ease), color 0.4s, transform 0.6s var(--ease); }
  .arrow :global(svg) { width: 38%; height: 38%; }
  .big:hover .arrow { background: var(--red); border-color: var(--red); transform: rotate(45deg); }
  .grid { display: grid; gap: 40px; margin-top: clamp(64px, 8vw, 120px); padding-top: 28px; border-top: 1px solid var(--rule); }
  @media (min-width: 760px) { .grid { grid-template-columns: 1.4fr 1fr; } }
  .f-name { font-family: var(--serif); font-size: 26px; margin: 0 0 8px; font-variation-settings: 'opsz' 48; }
  .f-line { color: var(--muted); max-width: 42ch; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 24px; }
  .bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; margin-top: 56px; }
</style>
