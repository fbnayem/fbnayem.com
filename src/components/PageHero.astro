---
const { eyebrow, title, lead, index = '' } = Astro.props;
---
<section class="page-hero">
  <div class="wrap">
    <div class="marker"><span class="label">{index}</span><span class="label">{eyebrow}</span></div>
    <h1 data-split="load" set:html={title} />
    {lead && <p class="lead reveal">{lead}</p>}
    <slot />
  </div>
</section>
<style>
  .marker .label:first-child:empty { display: none; }
</style>
