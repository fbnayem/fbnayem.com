---
const { eyebrow, title, lead } = Astro.props;
---
<section class="page-hero">
  <div class="orb" aria-hidden="true"></div>
  <div class="wrap">
    <span class="eyebrow">{eyebrow}</span>
    <h1 class="h-display" data-split="load">{title}</h1>
    {lead && <p class="lead reveal">{lead}</p>}
    <slot />
  </div>
</section>
