---
// Stand-in for the hero portrait until a real photo is supplied (see README).
import { ventures } from '../data/site';
---
<div class="visual" aria-hidden="true">
  <div class="orb"></div>
  <div class="frame">
    <div class="ring"></div>
    <span class="mono">FBN</span>
    <div class="chips">
      {ventures.map((v, i) => <span class="chip" style={`--d:${i * 0.12}s`}><i></i>{v.name}</span>)}
    </div>
  </div>
</div>

<style>
  .visual { position: relative; aspect-ratio: 4 / 5; width: min(100%, 460px); margin-inline: auto; }
  .orb {
    position: absolute; inset: -18%; border-radius: 50%; z-index: -1;
    background: radial-gradient(circle at 50% 45%, rgba(36,87,231,0.65), rgba(36,87,231,0.12) 45%, transparent 68%);
    filter: blur(8px); animation: breathe 9s ease-in-out infinite;
  }
  .frame {
    position: relative; height: 100%; border-radius: 28px; overflow: hidden;
    background:
      radial-gradient(120% 80% at 80% 0%, rgba(111,143,255,0.35), transparent 55%),
      radial-gradient(90% 70% at 0% 100%, rgba(36,87,231,0.4), transparent 60%),
      linear-gradient(160deg, #1a2440, #0d1426);
    border: 1px solid rgba(255,255,255,0.12);
    box-shadow: 0 40px 80px -40px rgba(0,0,0,0.8), inset 0 1px 0 rgba(255,255,255,0.08);
    display: grid; place-items: center;
  }
  .ring {
    position: absolute; width: 78%; aspect-ratio: 1; border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.12);
    box-shadow: 0 0 0 40px rgba(255,255,255,0.025), 0 0 0 80px rgba(255,255,255,0.015);
  }
  .mono {
    font-size: clamp(64px, 9vw, 112px); font-weight: 750; letter-spacing: -0.06em;
    background: linear-gradient(180deg, #fff, rgba(255,255,255,0.45)); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .chips { position: absolute; left: 20px; right: 20px; bottom: 20px; display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 999px; font-size: 13px; font-weight: 600;
    background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.12); color: #e9edf7;
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    animation: rise 0.9s var(--ease) both; animation-delay: calc(0.5s + var(--d));
  }
  .chip i { width: 7px; height: 7px; border-radius: 50%; background: #6f8fff; box-shadow: 0 0 10px #6f8fff; }
  @keyframes breathe { 50% { transform: scale(1.06); opacity: 0.85; } }
  @keyframes rise { from { opacity: 0; transform: translateY(10px); } }
</style>
