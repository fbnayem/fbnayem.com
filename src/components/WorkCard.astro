---
import Arrow from './Arrow.astro';
import type { Project } from '../data/site';
interface Props { project: Project; index: number }
const { project, index } = Astro.props;
// Flat printed plates: a paper tint and an ink colour per project, no gradients.
const plates = [
  { bg: '#1f3d2b', ink: '#e9e4c9' },
  { bg: '#d9a441', ink: '#2a1a0c' },
  { bg: '#2b3a8c', ink: '#efebe3' },
];
const plate = plates[index % plates.length];
---
<a class="work reveal" href={`/work/${project.slug}/`}>
  <div class="plate" style={`--bg:${plate.bg};--fg:${plate.ink}`} aria-hidden="true">
    <span class="fig label">Fig. {index + 1}</span>
    <span class="pname">{project.name}</span>
  </div>
  <div class="meta">
    <span class={project.type === 'Owned product' ? 'tag red' : 'tag'}>{project.type}</span>
    <span class="label">{project.category}</span>
  </div>
  <h3 class="h-card">{project.name}</h3>
  <p class="sum">{project.summary}</p>
  <span class="ulink">Read the story<Arrow /></span>
</a>

<style>
  .work { display: flex; flex-direction: column; text-decoration: none; }
  .plate { position: relative; aspect-ratio: 5 / 4; background: var(--bg); color: var(--fg); display: grid; place-items: center; overflow: hidden; margin-bottom: 22px; }
  .fig { position: absolute; left: 16px; top: 14px; color: var(--fg); opacity: 0.75; }
  .pname { font-family: var(--serif); font-style: italic; font-weight: 340; font-size: clamp(38px, 4vw, 60px); letter-spacing: -0.03em; font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1; transition: transform 0.9s var(--ease); }
  .work:hover .pname { transform: scale(1.06) rotate(-2deg); }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-bottom: 14px; }
  .h-card { margin-bottom: 10px; }
  .sum { color: var(--ink-2); flex: 1; }
  .ulink { align-self: flex-start; }
</style>
