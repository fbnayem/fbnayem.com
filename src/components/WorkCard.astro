---
import Arrow from './Arrow.astro';
import type { Project } from '../data/site';
interface Props { project: Project; index: number }
const { project, index } = Astro.props;
const looks = [
  'radial-gradient(80% 80% at 30% 20%,#d9f99d,transparent 60%),linear-gradient(135deg,#4ade80,#065f46)',
  'radial-gradient(80% 80% at 30% 20%,#fde68a,transparent 60%),linear-gradient(135deg,#fb923c,#7c2d12)',
  'radial-gradient(80% 80% at 30% 20%,#c7d2fe,transparent 60%),linear-gradient(135deg,#2457e7,#0b1120)',
];
---
<a class="card work tilt reveal" data-tilt="6" href={`/work/${project.slug}/`}>
  <span class="glare"></span>
  <div class="art" style={`background:${looks[index % 3]}`} aria-hidden="true"><span class="pop">{project.name}</span></div>
  <div class="meta pop">
    <span class={project.type === 'Owned product' ? 'tag' : 'tag neutral'}>{project.type}</span>
    <span class="cat">{project.category}</span>
  </div>
  <h3 class="h-card pop">{project.name}</h3>
  <p class="sum">{project.summary}</p>
  <span class="link-arrow">Read the Story<Arrow /></span>
</a>

<style>
  .work { padding: 14px 14px 32px !important; display: flex !important; flex-direction: column; }
  .work > :not(.art):not(.glare) { margin-inline: 18px; }
  .art { aspect-ratio: 4 / 3; border-radius: 16px; margin-bottom: 26px; display: grid; place-items: center; overflow: hidden; }
  .art span { font-family: var(--display); font-size: clamp(36px, 3.6vw, 52px); font-weight: 800; letter-spacing: -0.05em; color: #fff; text-shadow: 0 10px 40px rgba(0,0,0,0.35); transition: transform 0.8s var(--ease); }
  .work:hover .art span { transform: translateZ(60px) scale(1.08); }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 16px; }
  .cat { font-size: 14px; color: var(--muted); }
  .sum { color: var(--muted); margin: 12px 18px 20px !important; flex: 1; }
  .link-arrow { margin-top: auto; }
</style>
