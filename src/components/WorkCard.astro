---
import Arrow from './Arrow.astro';
import type { Project } from '../data/site';
interface Props { project: Project; index: number }
const { project, index } = Astro.props;
const looks = [
  'linear-gradient(135deg,#d9f99d,#4ade80 55%,#15803d)',
  'linear-gradient(135deg,#fde68a,#fb923c 55%,#9a3412)',
  'linear-gradient(135deg,#c7d2fe,#2457e7 60%,#0b1120)',
];
---
<a class="card work reveal" href={`/work/${project.slug}/`} style={`transition-delay:${index * 80}ms`}>
  <div class="art" style={`background:${looks[index % 3]}`} aria-hidden="true">
    <span>{project.name}</span>
  </div>
  <div class="meta">
    <span class={project.type === 'Owned product' ? 'tag' : 'tag neutral'}>{project.type}</span>
    <span class="cat">{project.category}</span>
  </div>
  <h3 class="h-card">{project.name}</h3>
  <p class="sum">{project.summary}</p>
  <span class="link-arrow">Read the Story<Arrow /></span>
</a>

<style>
  .work { padding: 12px 12px 28px !important; display: flex !important; flex-direction: column; }
  .work > :not(.art) { margin-inline: 16px; }
  .art {
    aspect-ratio: 16 / 10; border-radius: 12px; margin-bottom: 22px; display: grid; place-items: center; overflow: hidden; position: relative;
  }
  .art span {
    font-size: clamp(28px, 3vw, 40px); font-weight: 750; letter-spacing: -0.04em; color: rgba(255,255,255,0.92);
    text-shadow: 0 8px 30px rgba(0,0,0,0.25); transition: transform 0.6s var(--ease);
  }
  .work:hover .art span { transform: scale(1.06); }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 14px; }
  .cat { font-size: 14px; color: var(--muted); }
  .sum { color: var(--muted); margin: 10px 16px 18px !important; flex: 1; }
  .link-arrow { margin-top: auto; }
</style>
