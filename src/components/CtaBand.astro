---
import Arrow from './Arrow.astro';
const {
  eyebrow = "Let's talk",
  title = 'Have something <em>worth building?</em>',
  body = "I'm interested in practical problems, thoughtful partnerships, and products that make work easier. Tell me what you're working on.",
  label = "Let's Connect",
} = Astro.props;
---
<section class="section cta">
  <div class="wrap">
    <div class="marker"><span class="label">{eyebrow}</span></div>
    <div class="row">
      <h2 class="h-section" data-split set:html={title} />
      <div class="side">
        <p class="lead">{body}</p>
        <a href="/connect/" class="btn">{label}<Arrow /></a>
      </div>
    </div>
  </div>
</section>
<style>
  .row { display: grid; gap: 36px; margin-top: 40px; }
  @media (min-width: 960px) { .row { grid-template-columns: 1.3fr 1fr; align-items: end; } }
  h2 { max-width: 12ch; }
  .lead { margin-bottom: 28px; }
</style>
