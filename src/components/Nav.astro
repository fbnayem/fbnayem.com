---
import { nav } from '../data/site';
const path = Astro.url.pathname;
---
<header class="nav" data-nav>
  <div class="wrap nav-inner">
    <a href="/" class="brand" aria-label="Fazle Bary Nayem, home">
      <span class="mark" aria-hidden="true">N</span>
      <span class="brand-name">Fazle Bary Nayem</span>
    </a>
    <nav aria-label="Main">
      <ul class="links" id="menu">
        {nav.map((item) => (
          <li><a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
        <li class="cta-item"><a href="/connect/" class="btn btn-primary nav-cta">Let's Connect</a></li>
      </ul>
    </nav>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn>
      <span class="menu-label">Menu</span>
      <span class="bars" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>
</header>

<style>
  .nav {
    position: fixed; inset: 0 0 auto; z-index: 50; padding-block: 14px;
    transition: background 0.3s, border-color 0.3s, backdrop-filter 0.3s, padding 0.3s;
    border-bottom: 1px solid transparent; color: var(--on-dark);
  }
  .nav.scrolled {
    background: rgba(11, 17, 32, 0.72); backdrop-filter: saturate(160%) blur(16px);
    -webkit-backdrop-filter: saturate(160%) blur(16px); border-color: rgba(255,255,255,0.08); padding-block: 10px;
  }
  .nav.light:not(.open) { color: var(--ink); }
  .nav.light.scrolled:not(.open) { background: rgba(247, 246, 242, 0.8); border-color: var(--line); }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; font-weight: 650; letter-spacing: -0.02em; min-height: 44px; }
  .mark {
    width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; font-size: 17px; font-weight: 750;
    background: linear-gradient(135deg, #2457e7, #6f8fff); color: #fff; box-shadow: 0 6px 18px -6px rgba(36,87,231,0.9);
  }
  .links { display: flex; align-items: center; gap: 6px; list-style: none; margin: 0; padding: 0; }
  .links a:not(.btn) {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px; border-radius: 999px;
    text-decoration: none; font-size: 15px; font-weight: 500; opacity: 0.78; transition: opacity 0.2s, background 0.2s;
  }
  .links a:not(.btn):hover, .links a[aria-current='page'] { opacity: 1; }
  .links a[aria-current='page'] { background: rgba(127,127,127,0.14); }
  .nav-cta { min-height: 42px; padding: 0 18px; font-size: 15px; margin-left: 8px; }
  .menu-btn {
    display: none; align-items: center; gap: 10px; min-height: 44px; padding: 0 16px; border-radius: 999px;
    background: transparent; border: 1px solid currentColor; color: inherit; font: inherit; font-size: 15px; font-weight: 600; cursor: pointer;
  }
  .bars { display: grid; gap: 4px; }
  .bars span { display: block; width: 16px; height: 1.6px; background: currentColor; transition: transform 0.3s var(--ease); }
  .open .bars span:first-child { transform: translateY(2.8px) rotate(45deg); }
  .open .bars span:last-child { transform: translateY(-2.8px) rotate(-45deg); }

  @media (max-width: 860px) {
    .brand-name { display: none; }
    .menu-btn { display: inline-flex; }
    .links {
      position: fixed; inset: 0; z-index: -1; flex-direction: column; align-items: stretch; justify-content: center; gap: 4px;
      padding: 96px var(--gutter) 40px; background: var(--dark); color: var(--on-dark);
      opacity: 0; visibility: hidden; transition: opacity 0.3s, visibility 0.3s;
    }
    .open .links { opacity: 1; visibility: visible; }
    .links a:not(.btn) { font-size: 32px; font-weight: 600; letter-spacing: -0.03em; padding: 8px 0; opacity: 1; }
    .links a[aria-current='page'] { background: none; color: #8fb0ff; }
    .cta-item { margin-top: 24px; }
    .nav-cta { margin: 0; width: 100%; justify-content: center; min-height: 52px; font-size: 17px; }
    .open { color: var(--on-dark); }
  }
</style>

<script>
  function initNav() {
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
    if (!nav || !btn) return;
    const light = document.body.dataset.heroTone === 'light';
    nav.classList.toggle('light', light);
    const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    const close = (focusBtn = false) => {
      nav.classList.remove('open'); btn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = ''; if (focusBtn) btn.focus();
    };
    btn.addEventListener('click', () => {
      const open = !nav.classList.contains('open');
      nav.classList.toggle('open', open); btn.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) nav.querySelector<HTMLAnchorElement>('#menu a')?.focus();
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && nav.classList.contains('open')) close(true); });
    nav.querySelectorAll('#menu a').forEach((a) => a.addEventListener('click', () => close()));
  }
  initNav();
</script>
