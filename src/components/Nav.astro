---
import { nav } from '../data/site';
const path = Astro.url.pathname;
---
<header class="nav" data-nav>
  <div class="wrap nav-inner">
    <a href="/" class="brand" aria-label="Fazle Bary Nayem, home">
      Fazle Bary Nayem<span class="red">.</span>
    </a>
    <p class="clock label" aria-hidden="true">Dhaka <span data-clock>--:--</span></p>
    <nav aria-label="Main" class="menu" id="menu">
      <ul>
        {nav.map((item, i) => (
          <li style={`--i:${i}`}>
            <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
              <span class="idx label">0{i + 1}</span>{item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn>
      <span class="open-t">Menu</span><span class="close-t">Close</span>
    </button>
  </div>
</header>

<style>
  .nav { position: fixed; inset: 0 0 auto; z-index: 100; transition: transform 0.6s var(--ease), background 0.3s; }
  .nav.solid { background: color-mix(in srgb, var(--paper) 92%, transparent); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border-bottom: 1px solid var(--rule); }
  .nav.hide { transform: translateY(-100%); }
  .nav-inner { display: flex; align-items: center; gap: 24px; min-height: 72px; }
  .brand { font-family: var(--serif); font-size: 22px; font-weight: 450; letter-spacing: -0.02em; text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; font-variation-settings: 'opsz' 48; }
  .clock { margin: 0 0 0 24px; }
  .menu { margin-left: auto; }
  ul { display: flex; gap: 28px; list-style: none; margin: 0; padding: 0; }
  .menu a { position: relative; display: inline-flex; align-items: baseline; gap: 6px; min-height: 44px; align-items: center; text-decoration: none; font-weight: 500; font-size: 16px; }
  .idx { display: none; }
  .menu a::after { content: ''; position: absolute; left: 0; right: 0; bottom: 10px; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: right; transition: transform 0.45s var(--ease); }
  .menu a:hover::after, .menu a[aria-current='page']::after { transform: scaleX(1); transform-origin: left; }
  .menu a[aria-current='page'] { color: var(--red); }
  .menu-btn { display: none; margin-left: auto; min-height: 44px; padding: 0 2px; background: none; border: 0; color: var(--ink); font: 500 16px var(--sans); cursor: pointer; text-decoration: underline; text-underline-offset: 5px; position: relative; z-index: 2; }
  .close-t { display: none; }
  .open .open-t { display: none; } .open .close-t { display: inline; }

  @media (max-width: 860px) {
    .clock { display: none; }
    .menu-btn { display: inline-block; }
    .menu { position: fixed; inset: 0; background: var(--paper); clip-path: inset(0 0 100% 0); transition: clip-path 0.7s var(--ease); visibility: hidden; }
    .open .menu { clip-path: inset(0 0 0 0); visibility: visible; }
    ul { height: 100%; flex-direction: column; justify-content: center; gap: 0; padding: 96px var(--gutter) 48px; }
    li { border-top: 1px solid var(--rule); opacity: 0; transform: translateY(20px); transition: opacity 0.5s var(--ease), transform 0.6s var(--ease); transition-delay: calc(0.2s + var(--i) * 0.05s); }
    li:last-child { border-bottom: 1px solid var(--rule); }
    .open li { opacity: 1; transform: none; }
    .menu a { width: 100%; gap: 18px; padding: 10px 0; font-family: var(--serif); font-weight: 360; font-size: clamp(40px, 11vw, 60px); letter-spacing: -0.03em; }
    .menu a::after { display: none; }
    .idx { display: inline; }
  }
</style>

<script>
  function initNav() {
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
    const clock = document.querySelector<HTMLElement>('[data-clock]');
    if (!nav || !btn) return;

    const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Dhaka', hour: '2-digit', minute: '2-digit' });
    const tick = () => { if (clock) clock.textContent = fmt.format(new Date()); };
    tick();
    const timer = window.setInterval(tick, 15000);

    let last = window.scrollY;
    const onScroll = () => {
      const y = window.scrollY;
      nav.classList.toggle('solid', y > 40);
      nav.classList.toggle('hide', y > 240 && y > last && !nav.classList.contains('open'));
      last = y;
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    const close = (focusBtn = false) => {
      nav.classList.remove('open'); btn.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      if (focusBtn) btn.focus();
    };
    btn.addEventListener('click', () => {
      const open = !nav.classList.contains('open');
      nav.classList.toggle('open', open); btn.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
    });
    const onKey = (e: KeyboardEvent) => { if (e.key === 'Escape' && nav.classList.contains('open')) close(true); };
    document.addEventListener('keydown', onKey);
    nav.querySelectorAll('#menu a').forEach((a) => a.addEventListener('click', () => close()));

    document.addEventListener('astro:before-swap', () => {
      window.clearInterval(timer);
      window.removeEventListener('scroll', onScroll);
      document.removeEventListener('keydown', onKey);
      document.documentElement.style.overflow = '';
    }, { once: true });
  }
  document.addEventListener('astro:page-load', initNav);
</script>
