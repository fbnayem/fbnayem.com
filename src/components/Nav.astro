---
import { nav } from '../data/site';
const path = Astro.url.pathname;
---
<header class="nav" data-nav>
  <div class="wrap nav-inner">
    <a href="/" class="brand" aria-label="Fazle Bary Nayem, home">
      <span class="mark" aria-hidden="true">N</span>
      <span class="brand-name">Fazle Bary Nayem</span>
    </a>
    <nav aria-label="Main" class="pill">
      <ul class="links" id="menu">
        {nav.map((item, i) => (
          <li style={`--i:${i}`}><a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
        <li class="cta-item" style={`--i:${nav.length}`}><a href="/connect/" class="btn btn-primary nav-cta" data-magnetic>Let's Connect</a></li>
      </ul>
    </nav>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn>
      <span>Menu</span><span class="bars" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<style>
  .nav { position: fixed; inset: 0 0 auto; z-index: 100; padding-block: 18px; transition: transform 0.5s var(--ease), padding 0.3s; }
  .nav.hide { transform: translateY(-120%); }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; font-family: var(--display); font-weight: 700; font-size: 18px; letter-spacing: -0.02em; min-height: 44px; }
  .mark { width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; font-size: 20px; font-weight: 800; color: #050608; background: var(--lime); box-shadow: 0 0 30px -6px rgba(200,255,61,0.7); transition: transform 0.6s var(--ease); }
  .brand:hover .mark { transform: rotate(-12deg) scale(1.08); }
  .pill { padding: 6px; border-radius: 999px; background: rgba(13,18,32,0.55); border: 1px solid var(--line); backdrop-filter: blur(18px) saturate(160%); -webkit-backdrop-filter: blur(18px) saturate(160%); }
  .links { display: flex; align-items: center; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .links a:not(.btn) { position: relative; display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border-radius: 999px; text-decoration: none; font-size: 15px; font-weight: 500; color: var(--muted); transition: color 0.25s, background 0.25s; }
  .links a:not(.btn):hover { color: var(--ink); }
  .links a[aria-current='page'] { color: var(--ink); background: rgba(255,255,255,0.08); }
  .nav-cta { min-height: 44px; padding: 0 20px; font-size: 15px; margin-left: 6px; }
  .menu-btn { display: none; align-items: center; gap: 12px; min-height: 48px; padding: 0 20px; border-radius: 999px; background: rgba(13,18,32,0.6); border: 1px solid var(--line-2); color: var(--ink); font: inherit; font-size: 15px; font-weight: 600; cursor: pointer; backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); position: relative; z-index: 2; }
  .bars { display: grid; gap: 5px; }
  .bars i { display: block; width: 18px; height: 1.8px; background: currentColor; transition: transform 0.4s var(--ease); }
  .open .bars i:first-child { transform: translateY(3.4px) rotate(45deg); }
  .open .bars i:last-child { transform: translateY(-3.4px) rotate(-45deg); }

  @media (max-width: 900px) {
    .brand-name { display: none; }
    .menu-btn { display: inline-flex; }
    .pill { position: fixed; inset: 0; padding: 0; border: 0; border-radius: 0; background: #07090f; clip-path: circle(0% at calc(100% - 60px) 42px); transition: clip-path 0.8s var(--ease); visibility: hidden; }
    .open .pill { clip-path: circle(150% at calc(100% - 60px) 42px); visibility: visible; }
    .links { height: 100%; flex-direction: column; align-items: flex-start; justify-content: center; gap: 0; padding: 100px var(--gutter) 48px; }
    .links li { opacity: 0; transform: translateY(30px); transition: opacity 0.6s var(--ease), transform 0.6s var(--ease); transition-delay: calc(0.15s + var(--i) * 0.06s); }
    .open .links li { opacity: 1; transform: none; }
    .links a:not(.btn) { font-family: var(--display); font-size: clamp(44px, 12vw, 64px); font-weight: 700; letter-spacing: -0.04em; padding: 4px 0; color: var(--ink); background: none !important; }
    .links a[aria-current='page'] { color: var(--lime); }
    .cta-item { margin-top: 32px; width: 100%; }
    .nav-cta { margin: 0; width: 100%; justify-content: center; min-height: 58px; font-size: 17px; }
  }
</style>

<script>
  function initNav() {
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
    if (!nav || !btn) return;
    let last = window.scrollY;
    const onScroll = () => {
      const y = window.scrollY;
      nav.classList.toggle('hide', y > 200 && y > last && !nav.classList.contains('open'));
      last = y;
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    const close = (focusBtn = false) => {
      nav.classList.remove('open'); btn.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = ''; if (focusBtn) btn.focus();
    };
    btn.addEventListener('click', () => {
      const open = !nav.classList.contains('open');
      nav.classList.toggle('open', open); btn.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) setTimeout(() => nav.querySelector<HTMLAnchorElement>('#menu a')?.focus(), 300);
    });
    const onKey = (e: KeyboardEvent) => { if (e.key === 'Escape' && nav.classList.contains('open')) close(true); };
    document.addEventListener('keydown', onKey);
    nav.querySelectorAll('#menu a').forEach((a) => a.addEventListener('click', () => close()));
    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('scroll', onScroll); document.removeEventListener('keydown', onKey);
      document.documentElement.style.overflow = '';
    }, { once: true });
  }
  document.addEventListener('astro:page-load', initNav);
</script>
