---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Arrow from '../components/Arrow.astro';
import { faqs } from '../data/site';
const types = ['Project', 'Partnership', 'Investment', 'Speaking or media', 'General'];
---
<Base title="Contact Fazle Bary Nayem | Projects and Partnerships" description="Contact Nayem about projects, partnerships, investment conversations, speaking opportunities, or media inquiries.">
  <PageHero index="Connect" eyebrow="Projects, partnerships, press" title="Tell me what <em>you're working on.</em>" lead="For projects, partnerships, product conversations, investment discussions, or speaking and media inquiries, send a short introduction below. Include the context that will help me understand your idea and the next step you have in mind." />

  <section class="section">
    <div class="wrap split-2">
      <div class="reveal">
        <div class="notice">
          <span class="tag red">Opening soon</span>
          <p>The contact form is being connected and will start accepting messages shortly. For project work today, you can reach my team at Abedin Tech.</p>
          <a class="ulink" href="https://abedintech.com" target="_blank" rel="noopener">Contact Abedin Tech<Arrow diagonal /><span class="sr-only"> (opens in a new tab)</span></a>
        </div>
      </div>
      <form class="form reveal" aria-describedby="form-status" onsubmit="return false">
        <div class="row">
          <label>Name <span aria-hidden="true">*</span><input name="name" required autocomplete="name" /></label>
          <label>Email <span aria-hidden="true">*</span><input name="email" type="email" required autocomplete="email" /></label>
        </div>
        <label>Inquiry type <span aria-hidden="true">*</span>
          <select name="type" required>
            <option value="">Choose one</option>
            {types.map((t) => <option>{t}</option>)}
          </select>
        </label>
        <label>Company or website <small>(optional)</small><input name="company" autocomplete="organization" /></label>
        <label>Message <span aria-hidden="true">*</span><textarea name="message" rows="6" required></textarea></label>
        <p class="note">Your details will be used to respond to this inquiry. Read the <a href="/privacy/">Privacy page</a> for more information.</p>
        <button class="btn" type="submit" disabled>Send Message</button>
        <p id="form-status" class="status">Sending opens once the form is connected.</p>
      </form>
    </div>
  </section>

  <section class="section faq-wrap">
    <div class="wrap split-2">
      <div class="reveal"><div class="marker"><span class="label">Questions</span></div><h2 class="h-section" style="margin-top:32px">Before <em>you write</em></h2></div>
      <div class="faq reveal">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}<span class="plus" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .notice { display: grid; gap: 16px; justify-items: start; padding: 28px 0; border-top: 1px solid var(--rule-strong); border-bottom: 1px solid var(--rule); }
  .notice p { margin: 0; color: var(--ink-2); font-family: var(--serif); font-size: 22px; line-height: 1.4; font-variation-settings: 'opsz' 48; }
  .form { display: grid; gap: 22px; }
  .row { display: grid; gap: 22px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  label { display: grid; gap: 6px; font-family: var(--mono); font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); }
  label span { color: var(--red); }
  small { text-transform: none; }
  input, select, textarea {
    font: 400 19px var(--sans); color: var(--ink); background: transparent; border: 0; border-bottom: 1px solid var(--rule-strong); border-radius: 0;
    padding: 10px 0; min-height: 48px; width: 100%; transition: border-color 0.2s;
  }
  input:focus, select:focus, textarea:focus { outline: none; border-bottom-color: var(--red); box-shadow: 0 1px 0 var(--red); }
  textarea { resize: vertical; }
  .note, .status { font-size: 15px; color: var(--muted); margin: 0; }
  .note a { color: var(--red); }
  button[disabled] { opacity: 0.45; cursor: not-allowed; justify-self: start; }
  button[disabled]:hover { background: var(--ink); border-color: var(--ink); }
  .faq-wrap { background: var(--paper-2); }
  .faq details { border-top: 1px solid var(--rule-strong); }
  .faq details:last-child { border-bottom: 1px solid var(--rule-strong); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 22px 0; font-family: var(--serif); font-size: clamp(22px, 2vw, 28px); line-height: 1.2; min-height: 44px; font-variation-settings: 'opsz' 48; }
  summary::-webkit-details-marker { display: none; }
  .plus { position: relative; width: 14px; height: 14px; flex: none; }
  .plus::before, .plus::after { content: ''; position: absolute; left: 0; top: 6px; width: 14px; height: 1.5px; background: var(--red); transition: transform 0.3s var(--ease); }
  .plus::after { transform: rotate(90deg); }
  details[open] .plus::after { transform: rotate(0); }
  details p { color: var(--ink-2); padding-bottom: 22px; margin: 0; max-width: 60ch; }
</style>
