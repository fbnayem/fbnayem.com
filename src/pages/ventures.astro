---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Arrow from '../components/Arrow.astro';
import CtaBand from '../components/CtaBand.astro';
import { ventures } from '../data/site';
---
<Base title="Ventures | Abedin Tech, Callinva and SaleAnto" description="Explore the companies and products Fazle Bary Nayem is building across AI calling, social content, software, and business automation.">
  <PageHero index="Ventures" eyebrow={`${ventures.length} ventures`} title="The businesses and products <em>I'm building.</em>" lead="My work combines client delivery with product development. Each venture explores a different way to help businesses use technology more effectively." />

  {ventures.map((v, i) => (
    <section class={i % 2 ? 'section v alt' : 'section v'} id={v.slug}>
      <div class="wrap">
        <div class="marker"><span class="label">0{i + 1} / 0{ventures.length}</span><span class="label">{v.category}</span></div>
        <div class="grid">
          <div class="head">
            <h2 class="name" data-split>{v.name}</h2>
            <dl class="dl">
              <div><dt>Role</dt><dd>{v.role}</dd></div>
              <div><dt>Site</dt><dd><a class="ulink" href={v.url} target="_blank" rel="noopener">{v.domain}<Arrow diagonal /><span class="sr-only"> (opens in a new tab)</span></a></dd></div>
            </dl>
          </div>
          <div class="body reveal">
            {v.body.map((p, j) => <p class={j === 0 ? 'first' : ''}>{p}</p>)}
            {v.focus && (
              <ul class="focus">{v.focus.map((f) => <li>{f}</li>)}</ul>
            )}
            <a href={v.url} target="_blank" rel="noopener" class="btn">{v.cta}<Arrow diagonal /><span class="sr-only"> (opens in a new tab)</span></a>
          </div>
        </div>
      </div>
    </section>
  ))}
  <CtaBand />
</Base>

<style>
  .v { padding-block: clamp(72px, 8vw, 120px); }
  .alt { background: var(--paper-2); }
  .grid { display: grid; gap: 40px; margin-top: 40px; }
  @media (min-width: 960px) { .grid { grid-template-columns: 1fr 1fr; gap: 80px; } }
  .name { font-size: clamp(56px, 8vw, 132px); letter-spacing: -0.04em; margin-bottom: 40px; }
  .body p { color: var(--ink-2); max-width: 58ch; }
  .body .first { font-family: var(--serif); font-size: clamp(22px, 1.8vw, 28px); line-height: 1.35; color: var(--ink); font-variation-settings: 'opsz' 48; }
  .focus { list-style: none; padding: 0; margin: 28px 0 36px; counter-reset: f; }
  .focus li { counter-increment: f; display: grid; grid-template-columns: 40px 1fr; padding: 12px 0; border-top: 1px solid var(--rule); }
  .focus li:last-child { border-bottom: 1px solid var(--rule); }
  .focus li::before { content: counter(f, lower-roman) '.'; font-family: var(--serif); font-style: italic; color: var(--red); }
  .btn { margin-top: 12px; }
</style>
