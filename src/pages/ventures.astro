---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Arrow from '../components/Arrow.astro';
import CtaBand from '../components/CtaBand.astro';
import { ventures } from '../data/site';
const hues = ['#2457e7', '#0ea5a4', '#a855f7'];
---
<Base title="Ventures | Abedin Tech, Callinva and SaleAnto" description="Explore the companies and products Fazle Bary Nayem is building across AI calling, social content, software, and business automation.">
  <PageHero eyebrow="Ventures" title="The businesses and products I'm building." lead="My work combines client delivery with product development. Each venture explores a different way to help businesses use technology more effectively." />

  <section class="section">
    <div class="wrap list">
      {ventures.map((v, i) => (
        <article class="card v reveal" id={v.slug} style={`--hue:${hues.at(i)}`}>
          <div class="v-side">
            <span class="logo" aria-hidden="true">{v.name.charAt(0)}</span>
            <span class="num">0{i + 1}</span>
          </div>
          <div class="v-main">
            <p class="cat">{v.category}</p>
            <h2 class="h-section">{v.name}</h2>
            <p class="role"><span>Role</span>{v.role}</p>
            {v.body.map((p) => <p class="body">{p}</p>)}
            {v.focus && <ul class="focus">{v.focus.map((f) => <li>{f}</li>)}</ul>}
            <a href={v.url} target="_blank" rel="noopener" class="btn btn-primary">{v.cta}<Arrow diagonal /><span class="sr-only"> (opens in a new tab)</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>
  <CtaBand />
</Base>

<style>
  .list { display: grid; gap: 24px; }
  .v { display: grid !important; gap: 28px; grid-template-columns: 1fr; position: relative; overflow: hidden; }
  @media (min-width: 820px) { .v { grid-template-columns: 140px 1fr; padding: 56px !important; } }
  .v::before {
    content: ''; position: absolute; right: -160px; top: -160px; width: 420px; height: 420px; border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--hue) 18%, transparent), transparent 70%);
  }
  .v-side { display: flex; align-items: center; justify-content: space-between; }
  @media (min-width: 820px) { .v-side { flex-direction: column; align-items: flex-start; justify-content: space-between; } }
  .logo { width: 64px; height: 64px; border-radius: 18px; display: grid; place-items: center; font-weight: 750; font-size: 28px; color: #fff; background: var(--hue); box-shadow: 0 14px 30px -12px var(--hue); }
  .num { font-size: 14px; font-weight: 600; color: var(--muted); }
  .v-main { position: relative; max-width: 68ch; }
  .cat { color: var(--hue); font-weight: 600; font-size: 15px; margin-bottom: 10px; }
  .role { display: flex; gap: 10px; align-items: center; margin: 18px 0 22px; font-weight: 600; }
  .role span { font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); padding: 4px 10px; border: 1px solid var(--line); border-radius: 999px; }
  .body { color: #2a2d33; }
  .focus { list-style: none; padding: 0; margin: 8px 0 28px; display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .focus li { padding: 12px 16px; border-radius: 12px; background: var(--bg); font-weight: 500; font-size: 15px; }
  .btn { margin-top: 12px; }
</style>
