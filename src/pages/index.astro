---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Portrait from '../components/Portrait.astro';
import VentureCard from '../components/VentureCard.astro';
import WorkCard from '../components/WorkCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { profile, ventures, projects, principles } from '../data/site';
const skills = ['AI Products', 'Voice Agents', 'Business Automation', 'Custom Software', 'Digital Growth', 'SaaS'];
---
<Base
  title="Fazle Bary Nayem | Founder and AI Product Builder"
  description="Meet Fazle Bary Nayem, founder of Abedin Tech and builder behind Callinva and SaleAnto. Explore his ventures, selected work, and insights."
>
  <section class="hero">
    <canvas class="hero-canvas" data-hero3d aria-hidden="true"></canvas>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="name eyebrow">{profile.name} · {profile.role}</p>
        <h1 class="mega" data-split="load">I build <span class="grad">AI products</span> that help businesses work better.</h1>
        <div class="hero-foot">
          <p class="lead hero-lead">{profile.intro}</p>
          <div class="actions">
            <a href="/work/" class="btn btn-primary" data-magnetic>Explore My Work<Arrow /></a>
            <a href="/connect/" class="btn btn-ghost" data-magnetic>Let's Connect</a>
          </div>
        </div>
      </div>
      <div class="hero-photo" data-speed="0.15">
        <Portrait alt="Portrait of Fazle Bary Nayem" />
        <div class="float-chip c1"><span class="dot"></span>Based in Bangladesh</div>
        <div class="float-chip c2">Building for a global market</div>
      </div>
    </div>
    <div class="scroll-cue" aria-hidden="true"><span></span>Scroll</div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[...skills, ...skills].map((s) => <span>{s}</span>)}
    </div>
  </div>

  <section class="section statement">
    <div class="wrap">
      <span class="eyebrow">About</span>
      <p class="big-text" data-scrub-words>Running Abedin Tech has put me close to the problems businesses face every day: attracting customers, delivering work, managing follow-up, and keeping systems connected. That experience shapes the products I'm building today.</p>
      <a href="/about/" class="link-arrow">More About Me<Arrow /></a>
    </div>
  </section>

  <section class="ventures-h" data-hscroll>
    <div class="vh-inner">
      <div class="wrap vh-head">
        <span class="eyebrow">Ventures</span>
        <h2 class="h-section" data-split>What I'm building</h2>
        <p class="lead">My work spans client delivery and product development. These are the ventures at the center of that work.</p>
      </div>
      <div class="vh-clip"><div class="vh-track" data-hscroll-track>
        {ventures.map((v, i) => <div class="vh-item"><VentureCard venture={v} index={i} /></div>)}
        <a class="vh-item vh-more" href="/ventures/"><span class="h-card">All ventures</span><Arrow /></a>
      </div></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head row-head">
        <div>
          <span class="eyebrow">Selected work</span>
          <h2 class="h-section" data-split>Work that explains my approach</h2>
        </div>
        <a href="/work/" class="btn btn-ghost" data-magnetic>All work<Arrow /></a>
      </div>
      <div class="grid-3">
        {projects.map((p, i) => <WorkCard project={p} index={i} />)}
      </div>
    </div>
  </section>

  <section class="section light principles-sec">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">How I work</span>
        <h2 class="h-section" data-split>AI that fits how a business actually works.</h2>
        <p class="lead">The goal is to make a useful task easier, help people make better decisions, and create systems a team can rely on.</p>
      </div>
      <ol class="principles">
        {principles.map((p, i) => (
          <li class="reveal">
            <span class="num">0{i + 1}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero { position: relative; min-height: 100svh; display: flex; flex-direction: column; justify-content: center; padding-block: 140px 100px; overflow: hidden; isolation: isolate; }
  .hero-canvas { position: absolute; z-index: -1; top: 0; right: -14vw; width: 70vw; height: 100%; opacity: 0.9; }
  @media (max-width: 900px) { .hero-canvas { right: -30vw; width: 130vw; height: 80%; opacity: 0.55; } }
  .hero::after { content: ''; position: absolute; inset: auto 0 0; height: 30%; z-index: -1; background: linear-gradient(transparent, var(--bg)); }
  .hero-grid { display: grid; gap: 56px; align-items: center; grid-template-columns: 1fr; }
  @media (min-width: 1100px) { .hero-grid { grid-template-columns: 1.55fr 0.65fr; gap: 48px; } }
  .name { margin-bottom: 28px; }
  .hero-foot { display: grid; gap: 32px; margin-top: 44px; }
  @media (min-width: 900px) { .hero-foot { grid-template-columns: 1.1fr 1fr; align-items: end; } }
  .hero-lead { margin: 0; font-size: clamp(17px, 1vw + 12px, 20px); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-photo { position: relative; width: min(100%, 420px); margin-inline: auto; perspective: 1000px; }
  .float-chip { position: absolute; display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border-radius: 999px; font-size: 14px; font-weight: 600; background: rgba(13,18,32,0.7); border: 1px solid var(--line-2); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); animation: bob 6s ease-in-out infinite; }
  .c1 { left: -28px; bottom: 9%; }
  .c2 { right: -20px; top: 12%; animation-delay: -3s; }
  @media (max-width: 600px) { .c1 { left: -8px; } .c2 { right: -8px; } }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--lime); box-shadow: 0 0 12px var(--lime); }
  @keyframes bob { 50% { transform: translateY(-12px); } }
  .scroll-cue { position: absolute; left: 50%; bottom: 28px; translate: -50% 0; display: grid; justify-items: center; gap: 10px; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); }
  .scroll-cue span { width: 1px; height: 48px; background: linear-gradient(var(--lime), transparent); animation: cue 2s var(--ease) infinite; transform-origin: top; }
  @keyframes cue { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }

  .statement .big-text { font-family: var(--display); font-weight: 600; font-size: clamp(30px, 4.4vw, 68px); line-height: 1.08; letter-spacing: -0.035em; margin: 32px 0 40px; max-width: 22ch; }

  .ventures-h { position: relative; overflow: hidden; padding-block: clamp(80px, 10vw, 140px); }
  .vh-head { margin-bottom: 56px; display: grid; gap: 22px; }
  .vh-head .lead { max-width: 52ch; }
  .vh-track { display: grid; gap: 24px; padding-inline: var(--gutter); }
  @media (min-width: 1024px) {
    .ventures-h { min-height: 100vh; padding-block: 120px 80px; }
    .vh-inner { display: grid; grid-template-columns: 420px auto; align-items: center; min-height: calc(100vh - 200px); }
    .vh-head { margin: 0 0 0 max(var(--gutter), calc((100vw - var(--wrap)) / 2)); width: auto; }
    .vh-clip { overflow: hidden; padding-block: 40px; margin-block: -40px; mask-image: linear-gradient(90deg, transparent, #000 80px); -webkit-mask-image: linear-gradient(90deg, transparent, #000 80px); }
    .vh-track { display: flex; gap: 28px; width: max-content; padding-left: 48px; }
    .vh-item { width: 440px; flex: none; }
  }
  .vh-more { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 16px; min-height: 240px; border-radius: 24px; border: 1px dashed var(--line-2); text-decoration: none; color: var(--lime); transition: background 0.3s; }
  .vh-more:hover { background: rgba(200,255,61,0.06); }
  .vh-more :global(svg) { width: 32px; height: 32px; }
  @media (min-width: 1024px) { .vh-more { width: 280px !important; min-height: 520px; } }

  .row-head { max-width: none; display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 24px; }
  .row-head > div { display: grid; gap: 22px; max-width: 820px; }

  .principles-sec { border-radius: 40px 40px 0 0; }
  .principles { list-style: none; padding: 0; margin: 0; display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .principles li { padding: 40px 32px; border-radius: 24px; background: #fff; border: 1px solid rgba(0,0,0,0.08); transition: transform 0.5s var(--ease), box-shadow 0.5s; }
  .principles li:hover { transform: translateY(-8px) rotate(-0.6deg); box-shadow: 0 30px 60px -30px rgba(0,0,0,0.3); }
  .num { display: block; font-family: var(--display); font-weight: 800; font-size: 72px; line-height: 1; letter-spacing: -0.06em; color: var(--accent); margin-bottom: 40px; }
  .principles h3 { font-size: 28px; margin-bottom: 14px; }
  .principles p { color: #4b5160; margin: 0; }
</style>
