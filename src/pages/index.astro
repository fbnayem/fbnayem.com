---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Portrait from '../components/Portrait.astro';
import VentureRow from '../components/VentureRow.astro';
import WorkCard from '../components/WorkCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { profile, ventures, projects, principles } from '../data/site';
const skills = ['Answer every call', 'Follow up every lead', 'Book the meeting', 'Publish on time', 'Hand off to a person', 'Measure the outcome'];
const numerals = ['i.', 'ii.', 'iii.', 'iv.', 'v.'];
---
<Base
  title="Fazle Bary Nayem | Founder and AI Product Builder"
  description="Meet Fazle Bary Nayem, founder of Abedin Tech and builder behind Callinva and SaleAnto. Explore his ventures, selected work, and insights."
>
  <section class="hero">
    <canvas class="sheet" data-hero3d aria-hidden="true"></canvas>
    <div class="wrap">
      <div class="marker"><span class="label">Founder &amp; CEO, Abedin Tech</span><span class="label">Builder of Callinva and SaleAnto</span></div>
      <h1 class="display" data-split="load">AI that answers, follows up <em class="red">and gets it done.</em></h1>
      <div class="hero-foot">
        <p class="lead">{profile.intro}</p>
        <div class="actions">
          <a href="/connect/" class="btn">Start a conversation<Arrow /></a>
          <a href="/work/" class="ulink">See what we've shipped</a>
        </div>
      </div>
    </div>
  </section>

  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      {[...skills, ...skills].map((s) => <span>{s}</span>)}
    </div>
  </div>

  <section class="section about">
    <div class="wrap">
      <div class="marker"><span class="label">(01)</span><span class="label">The problem</span></div>
      <div class="about-grid">
        <div class="photo" data-speed="0.08">
          <Portrait alt="Portrait of Fazle Bary Nayem" caption="Fazle Bary Nayem, Bangladesh" />
        </div>
        <div>
          <p class="big-text reveal">Most AI projects stall between the demo and the daily workflow. Running a delivery company showed me exactly where they break: follow-up, handoff and systems that don't talk to each other. That is what I build for.</p>
          <p class="sig"><em>Fazle Bary Nayem</em><span class="label">Founder, Dhaka</span></p>
          <a href="/about/" class="ulink">The longer story<Arrow /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section night ventures">
    <div class="wrap">
      <div class="marker"><span class="label">(02)</span><span class="label">Ventures</span></div>
      <div class="sec-head">
        <h2 class="h-section" data-split>Three ventures. <em>One focus.</em></h2>
        <p class="lead">AI that runs real business workflows: one company that delivers it for clients, two products that package it for everyone else.</p>
      </div>
      <ol class="vlist">
        {ventures.map((v, i) => <VentureRow venture={v} index={i} />)}
      </ol>
      <a href="/ventures/" class="ulink all">All ventures in detail<Arrow /></a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="marker"><span class="label">(03)</span><span class="label">Selected work</span></div>
      <div class="sec-head">
        <h2 class="h-section" data-split>Built, shipped, <em>and learned from.</em></h2>
        <a href="/work/" class="btn btn-line">All work<Arrow /></a>
      </div>
      <div class="works">
        {projects.map((p, i) => <WorkCard project={p} index={i} />)}
      </div>
    </div>
  </section>

  <section class="section principles-sec">
    <div class="wrap">
      <div class="marker"><span class="label">(04)</span><span class="label">How I work</span></div>
      <div class="sec-head">
        <h2 class="h-section" data-split>AI that fits how a business <em>actually works.</em></h2>
        <p class="lead">The goal is to make a useful task easier, help people make better decisions, and create systems a team can rely on.</p>
      </div>
      <ol class="principles">
        {principles.map((p, i) => (
          <li class="reveal">
            <span class="num">{numerals[i]}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section night future">
    <div class="wrap">
      <div class="marker"><span class="label">(05)</span><span class="label">Where this is going</span></div>
      <div class="sec-head">
        <h2 class="h-section" data-split>AI that does the work <em>between the tools.</em></h2>
        <p class="lead">The next ten years: turn Callinva and SaleAnto into one operating layer for growing businesses, and build a product team in Bangladesh that ships to a global standard.</p>
      </div>
      <a href="/vision/" class="ulink all">The full plan, plus the 10 and 20-year vision<Arrow /></a>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero { position: relative; min-height: 100svh; display: flex; flex-direction: column; justify-content: flex-end; padding-block: 120px 56px; overflow: hidden; isolation: isolate; }
  .sheet { position: absolute; z-index: -1; top: 0; right: 0; width: 100%; height: 70%; opacity: 0.55;
    -webkit-mask-image: linear-gradient(90deg, transparent 5%, #000 60%); mask-image: linear-gradient(90deg, transparent 5%, #000 60%); }
  .sheet.is-static { background: url('/contours.svg') center / cover no-repeat; }
  @media (min-width: 1000px) { .sheet { width: 70%; height: 82%; opacity: 1; } }
  .hero .marker .label { background: var(--paper); padding-right: 8px; }
  .hero .marker .label:last-child { padding: 0 0 0 8px; }
  @media (max-width: 600px) { .hero .marker .label:last-child { display: none; } }
  .hero .display { margin: 36px 0 0; max-width: 11.5ch; }
  .hero-foot { display: grid; gap: 32px; margin-top: clamp(36px, 5vw, 64px); }
  @media (min-width: 900px) { .hero-foot { grid-template-columns: 1fr auto; align-items: end; } }
  .hero-foot .lead { margin: 0; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 28px; }

  .ticker { overflow: hidden; border-block: 1px solid var(--rule-strong); padding-block: 18px; }
  .ticker-track { display: flex; width: max-content; animation: tick 40s linear infinite; }
  .ticker span { font-family: var(--serif); font-style: italic; font-size: clamp(26px, 3vw, 44px); font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1; white-space: nowrap; padding-right: 0.9em; }
  .ticker span::after { content: '/'; font-style: normal; color: var(--red); padding-left: 0.9em; }
  @keyframes tick { to { transform: translateX(-50%); } }

  .about-grid { display: grid; gap: 48px; margin-top: 48px; }
  @media (min-width: 960px) { .about-grid { grid-template-columns: 0.42fr 1fr; gap: 80px; align-items: start; } }
  .photo { max-width: 420px; }
  .sig { display: flex; align-items: baseline; gap: 14px; margin: -8px 0 28px; font-family: var(--serif); font-size: 24px; }
  .big-text { font-family: var(--serif); font-weight: 340; font-size: clamp(30px, 3.8vw, 58px); line-height: 1.08; letter-spacing: -0.025em; margin: 0 0 36px; font-variation-settings: 'opsz' 144, 'SOFT' 30; }

  .sec-head { margin-top: 48px; }
  .vlist { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--rule); }
  .all { margin-top: 32px; }

  .works { display: grid; gap: 48px 32px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); }
  @media (min-width: 1100px) { .works > :nth-child(2) { margin-top: 96px; } }

  .principles-sec { background: var(--paper-2); }
  .principles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 0 40px; }
  .principles li { padding: 28px 0 8px; border-top: 1px solid var(--rule-strong); }
  .num { display: block; font-family: var(--serif); font-style: italic; font-size: 30px; color: var(--red); margin-bottom: 40px; font-variation-settings: 'opsz' 48, 'SOFT' 100, 'WONK' 1; }
  .principles h3 { font-size: clamp(28px, 2.4vw, 36px); margin-bottom: 14px; }
  .principles p { color: var(--ink-2); margin: 0; }

  .future .lead { max-width: 52ch; }
  .future .sec-head { margin-bottom: 40px; }
</style>
