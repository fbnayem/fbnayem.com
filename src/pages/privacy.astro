---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="Privacy | Fazle Bary Nayem" description="How fbnayem.com handles visitor information.">
  <PageHero index="Privacy" eyebrow="Last updated November 2026" title="How this site handles <em>your information.</em>" />
  <section class="section">
    <div class="wrap"><div class="prose">
      <p class="lead" style="color:var(--ink)">This page describes the site as it runs today. It will be updated before the contact form, booking or analytics are switched on.</p>
      <h2>What is collected today</h2>
      <p>The site does not use cookies, analytics or tracking scripts, and the contact form does not yet send or store messages.</p>
      <h2>Hosting</h2>
      <p>The site is hosted on Vercel, which processes standard technical request data, such as IP addresses, to deliver pages and keep the service secure.</p>
      <h2>Links to other sites</h2>
      <p>Links to Abedin Tech, Callinva, SaleAnto and other sites are covered by those sites' own privacy practices.</p>
    </div></div>
  </section>
</Base>
