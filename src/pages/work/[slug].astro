---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Arrow from '../../components/Arrow.astro';
import CtaBand from '../../components/CtaBand.astro';
import { projects, type Project } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props as { project: Project };
const others = projects.filter((p) => p.slug !== project.slug);
---
<Base title={`${project.name} | Selected Work | Fazle Bary Nayem`} description={project.summary}>
  <PageHero eyebrow={`${project.type} · ${project.category}`} title={project.title} lead={project.summary} />
  <section class="section">
    <div class="wrap split-2">
      <aside class="sticky reveal">
        <div class="card side">
          <p class="k">Project</p><p class="v">{project.name}</p>
          <p class="k">Type</p><p class="v">{project.type === 'Client work' ? 'Client work delivered through Abedin Tech' : 'Owned product'}</p>
          <p class="k">Focus</p><p class="v">{project.category}</p>
          {project.source && <><p class="k">Source</p><p class="v"><a href={project.source.url} target="_blank" rel="noopener">{project.source.label}</a></p></>}
        </div>
      </aside>
      <div class="prose reveal">
        <h2>The work</h2>
        {project.body.map((p) => <p>{p}</p>)}
        <div class="lesson">
          <span class="eyebrow">What it taught me</span>
          <p>{project.lesson}</p>
        </div>
        <a href="/work/" class="link-arrow">Back to all work<Arrow /></a>
      </div>
    </div>
  </section>
  <section class="section more">
    <div class="wrap">
      <h2 class="h-card" style="margin-bottom:24px">More work</h2>
      <div class="grid-3">
        {others.map((p) => (
          <a class="card tilt" data-tilt="6" href={`/work/${p.slug}/`}><span class="glare"></span>
            <span class={p.type === 'Owned product' ? 'tag' : 'tag neutral'}>{p.type}</span>
            <h3 class="h-card" style="margin:16px 0 8px">{p.name}</h3>
            <p style="color:var(--muted);margin:0">{p.summary}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .side .k { font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); font-weight: 600; margin: 0 0 4px; }
  .side .v { font-weight: 600; margin: 0 0 20px; }
  .side .v:last-child { margin-bottom: 0; }
  .side a { color: var(--lime); }
  .lesson { margin: 48px 0; padding: 40px; border-radius: var(--radius); background: var(--lime); color: #050608; }
  .lesson p { color: #050608; font-family: var(--display); font-size: clamp(26px, 2.8vw, 38px); line-height: 1.1; letter-spacing: -0.03em; font-weight: 700; margin: 16px 0 0; }
  .lesson .eyebrow { color: #050608; }
  .more { padding-top: 0; }
</style>
