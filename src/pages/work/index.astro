---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import WorkCard from '../../components/WorkCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { projects } from '../../data/site';
---
<Base title="Selected Work | Fazle Bary Nayem" description="Explore selected projects delivered through Abedin Tech and product work across software, AI, and digital growth.">
  <PageHero index="Work" eyebrow="Selected work" title="Built, shipped, <em>and learned from.</em>" lead="Client work through Abedin Tech and our own products. Each story covers the problem, what my team and I built, and the lesson we carried into the next project." />
  <section class="section">
    <div class="wrap works">
      {projects.map((p, i) => <WorkCard project={p} index={i} />)}
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .works { display: grid; gap: 56px 32px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); }
  @media (min-width: 1100px) { .works > :nth-child(2) { margin-top: 96px; } }
</style>
