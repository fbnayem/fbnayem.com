---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
---
<Base title="Page not found | Fazle Bary Nayem" description="This page could not be found." noindex>
  <section class="page-hero nf">
    <div class="orb" aria-hidden="true"></div>
    <div class="wrap">
      <span class="eyebrow">404</span>
      <h1 class="mega">This page could not be found.</h1>
      <p class="lead">You can return to the homepage or explore my work.</p>
      <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:32px">
        <a href="/" class="btn btn-primary">Back to Home<Arrow /></a>
        <a href="/work/" class="btn btn-ghost">Explore My Work</a>
      </div>
    </div>
  </section>
</Base>
<style>.nf { min-height: 80svh; display: flex; align-items: center; }</style>
